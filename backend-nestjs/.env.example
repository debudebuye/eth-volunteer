# Ethiopian Volunteer Platform - NestJS Backend
# Environment Variables Configuration

# ============================================
# REQUIRED VARIABLES
# ============================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/volunteer-db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-specific-password
EMAIL_FROM=noreply@volunteer.com

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DEST=./uploads

# Logging
LOG_LEVEL=info
